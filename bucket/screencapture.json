{
    "version": "2.5.15",
    "description": "A feature-rich screenshot program.",
    "homepage": "https://github.com/xland/ScreenCapture",
    "license": "LGPL-3.0-only",
    "url": "https://github.com/xland/ScreenCapture/releases/download/2.5.15/ScreenCapture.exe",
    "hash": "a080e7161d885d3bdec53c3388490cbdf23cb5f9a0b77e5963e47248258cd12d",
    "bin": "ScreenCapture.exe",
    "shortcuts": [
        [
            "ScreenCapture.exe",
            "ScreenCapture"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/xland/ScreenCapture/releases/download/$version/ScreenCapture.exe"
    },
    "pre_uninstall": [
        "$localCfg = Join-Path $dir 'config.json'",
        "$storeCfg = Join-Path $persist_dir 'config.json'",
        "# 卸载旧版前，如果本地存在配置，备份到持久目录",
        "if (Test-Path $localCfg) {",
        "    Copy-Item $localCfg $storeCfg -Force",
        "}"
    ],
    "post_install": [
        "$localCfg = Join-Path $dir 'config.json'",
        "$storeCfg = Join-Path $persist_dir 'config.json'",
        "# 仓库不存在，直接创建空文件",
        "if (-not (Test-Path $storeCfg)) {",
        "    New-Item $storeCfg -ItemType File -Force | Out-Null",
        "}",
        "# 把仓库文件复制到当前程序目录",
        "Copy-Item $storeCfg $localCfg -Force"
    ]
}
