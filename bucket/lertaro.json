{
    "version": "4.7.1",
    "description": "A modern, high-performance local file search and productivity launcher for Windows. | 超轻量、极速、高度可扩展的 Windows 全局搜索与效率启动工具",
    "homepage": "https://lertaro.github.io",
    "license": "MIT",
    "notes": [
        "便携模式下，应用配置、索引与缓存保存在 '$persist_dir\\Data'，已由 Scoop 自动持久化。",
        "已附带 CLI 检索工具 'lff' 与 GUI 启动别名 'lertaro'。",
        "运行需要 .NET 10 Desktop Runtime（windowsdesktop-runtime-10.0）。",
        "若启用了后台索引服务（LertaroService），卸载或更新时将自动安全停止服务。",
        "为避免覆盖冲突，建议在应用内设置中关闭自动更新，统一使用 'scoop update lertaro' 进行更新。"
    ],
    "suggest": {
        ".NET Desktop Runtime 10.0": "versions/windowsdesktop-runtime-10.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v4.7.1/Lertaro-Portable.zip",
            "hash": "7709b60cd60b4ea384bd83e8301a6c800e6f41bbe9965c3e66f7f9179946e9c1"
        },
        "arm64": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v4.7.1/Lertaro-Portable-arm64.zip",
            "hash": "eaf4b9435b122dc5c5b9fee828f9be34c3165d5efe937fa57348f7a4035c2a23"
        }
    },
    "extract_dir": "Lertaro",
    "bin": [
        "lff.exe",
        [
            "Lertaro.App.exe",
            "lertaro"
        ]
    ],
    "shortcuts": [
        [
            "Lertaro.App.exe",
            "Lertaro"
        ]
    ],
    "persist": "Data",
    "pre_uninstall": [
        "Stop-Service -Name 'LertaroService' -Force -ErrorAction SilentlyContinue",
        "Get-Process -Name 'Lertaro.App', 'Lertaro.Service', 'lff' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue"
    ],
    "post_uninstall": [
        "if ($purge) {",
        "    sc.exe stop LertaroService *>$null",
        "    sc.exe delete LertaroService *>$null",
        "    Remove-Item -Path 'HKCU:\\Software\\Classes\\lertaro' -Recurse -Force -ErrorAction SilentlyContinue",
        "    Remove-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run' -Name 'Lertaro' -Force -ErrorAction SilentlyContinue",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/Lertaro/Lertaro"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Portable.zip"
            },
            "arm64": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Portable-arm64.zip"
            }
        }
    }
}
