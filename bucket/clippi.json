{
    "version": "0.5.4",
    "description": "轻量化剪贴板管理工具，使用 Rust + GPUI 构建 | Lightweight clipboard manager built with Rust and GPUI。",
    "homepage": "https://github.com/Ruszero01/clippi",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Ruszero01/clippi/releases/download/v0.5.4/clippi-x86_64-pc-windows-msvc.zip",
            "hash": "6eeefee6dec55d6d09d0b91a00112b778e2fadfacde9eea692e31a170b7f0c34"
        }
    },
    "bin": "clippi.exe",
    "shortcuts": [
        [
            "clippi.exe",
            "Clippi"
        ]
    ],
    "checkver": {
        "github": "https://github.com/Ruszero01/clippi"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Ruszero01/clippi/releases/download/v$version/clippi-x86_64-pc-windows-msvc.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    },
    "pre_uninstall": [
        "# 1. 关闭正在运行的 clippi.exe",
        "Get-Process -Name 'clippi' -ErrorAction SilentlyContinue | Stop-Process -Force",
        "$localCfg = Join-Path $dir 'clippi.toml'",
        "$storeCfg = Join-Path $persist_dir 'clippi.toml'",
        "# 卸载旧版前，如果本地存在配置，备份到持久目录",
        "if (Test-Path $localCfg) {",
        "    Copy-Item $localCfg $storeCfg -Force",
        "}"
    ],
    "post_install": [
        "$localCfg = Join-Path $dir 'clippi.toml'",
        "$storeCfg = Join-Path $persist_dir 'clippi.toml'",
        "if (Test-Path $storeCfg) {",
        "# 把仓库文件复制到当前程序目录",
        "Copy-Item $storeCfg $localCfg -Force",
        "}"
    ]
}
